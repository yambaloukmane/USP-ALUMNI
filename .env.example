# Copiez ce fichier en ".env" puis remplissez les valeurs.

# --- Django ---
DJANGO_DEBUG=1
# Obligatoire quand DJANGO_DEBUG=0 (générez-en une : python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=
# Séparés par des virgules. Exemple en production : monsite.com,www.monsite.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Exemple en production : https://monsite.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
# IMPORTANT : après avoir activé la sécurité RLS (supabase/migrations/..._002_rls.sql),
# mettez ici la clé « service_role » (Project Settings > API). Ne la partagez jamais.
SUPABASE_KEY=

# --- Espace Responsable (page /responsable/) ---
# Choisissez un mot de passe solide. Sans valeur, l'accès est désactivé.
ADMIN_PASSWORD=

# --- Emails (code de vérification à l'inscription + formulaire de contact) ---
# Pour envoyer de VRAIS e-mails avec un compte Gmail :
#   1. Activez la validation en 2 étapes sur le compte Google
#   2. Créez un « mot de passe d'application » : https://myaccount.google.com/apppasswords
#   3. Renseignez les 3 lignes ci-dessous (EMAIL_BACKEND est alors choisi automatiquement)
# Sans EMAIL_HOST_USER / EMAIL_HOST_PASSWORD, les e-mails s'affichent seulement dans le terminal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=votre.adresse@gmail.com
EMAIL_HOST_PASSWORD=
# Avec Gmail, l'expéditeur doit être la même adresse que EMAIL_HOST_USER
DEFAULT_FROM_EMAIL=AEPS-ALUMNI <votre.adresse@gmail.com>

# Adresse qui reçoit les messages du formulaire de contact
CONTACT_EMAIL=yambaloukmane1@gmail.com
CONTACT_PHONE=+225 74 70 35 88

# --- Site et sécurité ---
# Adresse publique (e-mails, retour de paiement). En local : http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000
# 1 = un responsable doit valider chaque nouvelle inscription
REQUIRE_APPROVAL=0
# 1 derrière un proxy (Render, Railway, Nginx) pour lire la vraie IP du visiteur
TRUST_PROXY_HEADERS=0
# Cache partagé entre processus (optionnel) : redis://localhost:6379/1
REDIS_URL=

# --- Cotisations ---
DUES_AMOUNT=5000
DUES_CURRENCY=XOF
PAYMENT_INSTRUCTIONS=Payez par Wave ou Orange Money au numéro communiqué par le bureau.
# Paiement en ligne CinetPay (optionnel, nécessite SITE_URL public en https)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
